+    that lands there (a 10k/20k divider on a 5 V module reaches 3.33 V, where
+    the sensor itself never goes) is a deliberate trade-off, so it is logged
+    instead of refused.
     """
     declared = config.get(CONF_ADC_INPUT_MAX)
     if declared is None:
         return known_max
-    if not known or declared <= known_max:
-        return float(declared)
-    _LOGGER.warning(
