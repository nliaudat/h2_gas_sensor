-        "above it flatten",
-        label,
-        declared,
-        known_max,
-        known_max,
-    )
-    return known_max
+    if known and declared > known_max:
+        _LOGGER.debug(
+            "%s: 'adc_input_max: %.2f' is above the %.2f V the ADC measures at "
